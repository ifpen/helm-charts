{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": ["develop"],
  "packageRules": [
    {
      "description": "Suivre à la fois la version PHP et la version Alpine dans le tag de l'image de base",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-fpm-alpine(?<compatibility>\\d+\\.\\d+)$"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["filesender/filesender"],
      "extractVersion": "^v?(?<version>.*)$"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["simplesamlphp/simplesamlphp"],
      "extractVersion": "^v(?<version>.*)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "ARG FILESENDER_VERSION=(?<currentValue>.*)"
      ],
      "depNameTemplate": "filesender/filesender",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "ARG SIMPLESAMLPHP_VERSION=(?<currentValue>.*)"
      ],
      "depNameTemplate": "simplesamlphp/simplesamlphp",
      "datasourceTemplate": "github-releases"
    }
  ]
}
